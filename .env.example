# Zircon Agent — API Keys & Configuration
# Copy this file to .env and fill in your keys.
# Models in models.yaml can reference these via ${ENV_VAR_NAME}.

# OpenRouter API key
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Alternatively, you can add per-provider keys:
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# OPENAI_API_KEY=sk-your-key-here
# LOCAL_API_KEY=ollama  # no key needed for local models